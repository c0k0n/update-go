#!/usr/bin/env bash
#
# update-go — a tiny, careful updater for the Go toolchain.
#
# Works on Linux and macOS, and configures bash, zsh, or fish.
# It downloads the official archive straight from go.dev, verifies the
# published SHA-256 checksum, and replaces /usr/local/go in place.
#
# This is a personal tool shared in the hope it helps others. It is not
# affiliated with or endorsed by the Go project.

set -euo pipefail

# This placeholder is replaced with the release tag by the release workflow.
# An unstamped copy (run straight from the repository) reports "dev".
VERSION="__UPDATE_GO_VERSION__"
case "$VERSION" in
    __*) VERSION="dev" ;;
esac

# Where this project lives on GitHub (used by --update).
REPO_SLUG="c0k0n/update-go"

# Root under which Go lives (/usr/local by default, matching the official
# docs). Overridable so the test suite can exercise this exact script
# against a sandbox instead of the machine's real /usr/local.
INSTALL_ROOT="${UPDATE_GO_INSTALL_ROOT:-/usr/local}"
MANAGED_GO="$INSTALL_ROOT/go/bin/go"
GO_BIN_NEEDLE="$INSTALL_ROOT/go/bin"
# shellcheck disable=SC2016  # intentionally literal: matched against profile lines
GOPATH_NEEDLE='$(go env GOPATH)/bin'

# Temp dir + lock are cleaned up however the script ends.
CLEANUP_DIR=""
LOCK_PATH="${TMPDIR:-/tmp}/update-go.lock"
LOCK_HELD=0
cleanup() {
    [[ -n "$CLEANUP_DIR" ]] && rm -rf "$CLEANUP_DIR"
    [[ "$LOCK_HELD" -eq 1 ]] && rmdir "$LOCK_PATH" 2>/dev/null
    return 0
}
trap cleanup EXIT

acquire_lock() {
    if ! mkdir "$LOCK_PATH" 2>/dev/null; then
        error "Another update-go appears to be running ($LOCK_PATH)."
        error "If that's wrong, remove the lock directory and try again."
        exit 1
    fi
    LOCK_HELD=1
}

START_TIME="$(date +%s)"

# --------------------------------------------------
# Presentation
# --------------------------------------------------

# Color only real terminals — keep piped/CI output clean.
if [[ -t 1 ]]; then
    GREEN=$'\033[1;32m'
    BLUE=$'\033[1;34m'
    YELLOW=$'\033[1;33m'
    RED=$'\033[1;31m'
    RESET=$'\033[0m'
else
    GREEN=""; BLUE=""; YELLOW=""; RED=""; RESET=""
fi

info()    { echo "${BLUE}==>${RESET} $*"; }
success() { echo "${GREEN}✔${RESET} $*"; }
warn()    { echo "${YELLOW}⚠${RESET} $*"; }
error()   { echo "${RED}✖${RESET} $*" >&2; }

# curl with sane defaults: HTTPS only, modern TLS, fail on HTTP errors,
# follow redirects, ride out brief network hiccups.
fetch() {
    curl -fL --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 "$@"
}

# Print the version (e.g. go1.27.0) reported by the given Go binary.
go_version_of() {
    "$1" version 2>/dev/null | awk '{print $3}' || true
}

# Print the SHA-256 of a file using whichever tool the system provides.
compute_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        error "Need 'sha256sum' or 'shasum' to verify a checksum, but neither was found."
        return 1
    fi
}

# True if the profile has a non-comment line mentioning $1.
# Pure bash (no pipes) so an early match can't trip up pipefail.
profile_has() {
    local needle="$1" line
    [[ -r "$PROFILE" ]] || return 1
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" == *"$needle"* ]] && return 0
    done < "$PROFILE"
    return 1
}

usage() {
    cat <<'EOF'
update-go — update (or install) the Go toolchain from go.dev

Usage:
  update-go [options] [version]

Options:
  -f, --force     Reinstall even if already on the requested version
  -n, --check     Show what would happen, change nothing
  -u, --update    Update update-go itself to the latest release
      --uninstall Remove Go and the PATH lines update-go added
  -V, --version   Show the version of update-go and exit
  -h, --help      Show this help and exit

Examples:
  update-go              Install or update to the latest Go
  update-go 1.25.4       Install a specific version (stable releases only)
  update-go --check      Preview the update without changing anything

How it works:
  1. Looks up the release on go.dev (latest, or the one you asked for)
  2. Downloads the official tarball for your OS and architecture
  3. Verifies its published SHA-256 checksum
  4. Replaces /usr/local/go with the fresh version
  5. Makes sure /usr/local/go/bin and $GOPATH/bin are on your PATH

Good to know:
  * Needs curl, jq, and sudo (writing to /usr/local/go requires root)
  * Supports Linux and macOS, with bash, zsh, or fish
  * Safe to re-run: if you're already current, it simply says so
  * --update refreshes update-go itself from GitHub releases

Docs & issues: https://github.com/c0k0n/update-go
EOF
}

# --------------------------------------------------
# Self-update
# --------------------------------------------------

self_update() {
    local target="${BASH_SOURCE[0]}" dir self_path new_ver tmp_dir tmp_file

    # Follow symlinks so we replace the file that actually runs.
    while [[ -L "$target" ]]; do
        dir="$(cd -- "$(dirname -- "$target")" && pwd)"
        target="$(readlink -- "$target")"
        [[ "$target" == /* ]] || target="$dir/$target"
    done
    dir="$(cd -- "$(dirname -- "$target")" && pwd)"
    self_path="$dir/$(basename -- "$target")"

    if [[ ! -f "$self_path" ]]; then
        error "Couldn't locate this copy of update-go on disk ($self_path)."
        error "You can install the latest version manually with:"
        error "  curl -fsSL https://github.com/$REPO_SLUG/releases/latest/download/update-go -o ~/.local/bin/update-go"
        exit 1
    fi

    info "Checking for a newer version of update-go..."

    tmp_dir="$(mktemp -d)"
    CLEANUP_DIR="$tmp_dir"
    tmp_file="$tmp_dir/update-go.new"

    if ! fetch -s -o "$tmp_file" \
            "https://github.com/$REPO_SLUG/releases/latest/download/update-go"; then
        error "Couldn't download the latest update-go from GitHub."
        error "Check your internet connection and try again."
        exit 1
    fi

    # Only touch the running copy if the download looks like a healthy script.
    if [[ "$(head -n 1 "$tmp_file")" != '#!'* ]] || ! bash -n "$tmp_file"; then
        error "The downloaded file didn't look like a working update-go."
        error "Nothing was changed — please try again later."
        exit 1
    fi

    # Verify against the release's published checksums when available.
    local sums_file="$tmp_dir/SHA256SUMS" expected actual
    if fetch -s -o "$sums_file" \
            "https://github.com/$REPO_SLUG/releases/latest/download/SHA256SUMS"; then
        expected="$(awk '$2 == "update-go" {print $1}' "$sums_file")"
        actual="$(compute_sha256 "$tmp_file")"
        if [[ -z "$expected" || "$actual" != "$expected" ]]; then
            error "Checksum verification failed for the downloaded update-go."
            error "Nothing was changed — please try again later."
            exit 1
        fi
        success "Checksum verified."
    else
        warn "Couldn't fetch SHA256SUMS — continuing without an integrity check."
    fi

    new_ver="$(sed -n 's/^VERSION="\([^"]*\)"$/\1/p' "$tmp_file" | head -n 1)"
    case "$new_ver" in
        ""|__*) new_ver="unknown" ;;
    esac

    if [[ "$new_ver" == "$VERSION" ]]; then
        success "update-go is already up to date ($VERSION)."
        return 0
    fi

    info "Updating update-go: $VERSION -> $new_ver"

    # curl writes 0644; make sure the replacement stays executable.
    chmod +x "$tmp_file"

    if [[ -w "$dir" ]]; then
        mv -f "$tmp_file" "$self_path"
    else
        info "No write permission for $dir — using sudo."
        if ! sudo mv -f "$tmp_file" "$self_path"; then
            error "Couldn't replace $self_path."
            exit 1
        fi
    fi

    success "update-go updated to $new_ver."
    echo
    echo "Check it with: update-go --version"
}

# --------------------------------------------------
# Uninstall
# --------------------------------------------------

do_uninstall() {
    acquire_lock

    echo "This will:"
    echo "  * remove $INSTALL_ROOT/go"
    [[ -f /etc/paths.d/go ]] && echo "  * remove /etc/paths.d/go (left by the macOS .pkg installer)"
    echo "  * remove the PATH lines update-go added to $PROFILE"
    echo
    echo "Your Go code, modules, and installed tools (e.g. ~/go) are NOT touched."
    echo
    local reply
    read -r -p "Continue? [y/N] " reply || reply=""
    if ! [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]; then
        info "Aborted — nothing was changed."
        exit 0
    fi

    if [[ -e "$INSTALL_ROOT/go" ]]; then
        info "Removing $INSTALL_ROOT/go..."
        sudo rm -rf "$INSTALL_ROOT/go"
        success "Removed $INSTALL_ROOT/go."
    else
        info "$INSTALL_ROOT/go isn't present — skipping."
    fi

    if [[ -f /etc/paths.d/go ]]; then
        sudo rm -f /etc/paths.d/go
        success "Removed /etc/paths.d/go."
    fi

    if [[ -f "$PROFILE" ]]; then
        # Only strip lines identical to the ones this script adds — anything
        # you wrote yourself stays. Rewriting the original file in place keeps
        # its permissions.
        local tmp removed before after
        tmp="$(mktemp)"
        CLEANUP_DIR="$tmp"
        grep -vFx -e "$GO_LINE" -e "$GOPATH_LINE" "$PROFILE" > "$tmp" || true
        before="$(wc -l < "$PROFILE")"
        after="$(wc -l < "$tmp")"
        removed=$(( before - after ))
        if (( removed > 0 )); then
            cat "$tmp" > "$PROFILE"
            success "Removed $removed PATH line(s) from $PROFILE."
        else
            info "No update-go PATH lines found in $PROFILE."
        fi
    fi

    success "Go has been uninstalled."
    echo "Restart any open terminal sessions for the changes to take effect."
}

# --------------------------------------------------
# Argument parsing
# --------------------------------------------------

FORCE=0
DO_UPDATE=0
DO_CHECK=0
DO_UNINSTALL=0
REQUESTED_VER=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--force)   FORCE=1 ;;
        -n|--check)   DO_CHECK=1 ;;
        -u|--update)  DO_UPDATE=1 ;;
        --uninstall)  DO_UNINSTALL=1 ;;
        -V|--version) echo "update-go $VERSION"; exit 0 ;;
        -h|--help)    usage; exit 0 ;;
        -*)
            error "Unknown option: $1"
            echo
            usage
            exit 1
            ;;
        *)
            if [[ -n "$REQUESTED_VER" ]]; then
                error "Unexpected extra argument: $1"
                exit 1
            fi
            REQUESTED_VER="$1"
            ;;
    esac
    shift
done

if [[ -n "$REQUESTED_VER" ]]; then
    [[ "$REQUESTED_VER" == go* ]] || REQUESTED_VER="go$REQUESTED_VER"
    if ! [[ "$REQUESTED_VER" =~ ^go[0-9]+([.][0-9]+){0,2}$ ]]; then
        error "'$REQUESTED_VER' doesn't look like a Go version (e.g. 1.25.4 or go1.25.4)."
        exit 1
    fi
fi

if [[ "$DO_UPDATE" -eq 1 ]]; then
    self_update
    exit 0
fi

# --------------------------------------------------
# Detect platform
# --------------------------------------------------

OS="$(uname -s)"
case "$OS" in
    Linux)  GOOS="linux"  ;;
    Darwin) GOOS="darwin" ;;
    *)
        error "Unsupported operating system: $OS"
        error "update-go currently supports Linux and macOS only."
        exit 1
        ;;
esac

info "Detecting system architecture..."

ARCH="$(uname -m)"
case "$ARCH" in
    x86_64|amd64) GOARCH="amd64" ;;
    aarch64|arm64) GOARCH="arm64" ;;
    i386|i486|i586|i686) GOARCH="386" ;;
    armv6l|armv7l) GOARCH="armv6l" ;;  # Go publishes one 32-bit ARM build; runs on v6 and v7
    *)
        error "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac

# --------------------------------------------------
# Detect shell + the profile we should edit
# --------------------------------------------------

detect_shell() {
    SHELL_NAME="$(basename "${SHELL:-/bin/bash}")"

    # POSIX-style defaults; fish overrides these below.
    case "$SHELL_NAME" in
        zsh)
            PROFILE="$HOME/.zshrc"
            ;;
        bash)
            # macOS bash is usually a login shell (uses .bash_profile).
            if [[ "$GOOS" == "darwin" ]]; then
                PROFILE="$HOME/.bash_profile"
            else
                PROFILE="$HOME/.bashrc"
            fi
            ;;
        fish)
            # fish reads $XDG_CONFIG_HOME/fish/config.fish, which defaults
            # to ~/.config/fish/config.fish.
            PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
            ;;
        *)
            PROFILE="$HOME/.profile"
            ;;
    esac

    if [[ "$SHELL_NAME" == "fish" ]]; then
        # fish_add_path is fish's official helper: it deduplicates entries
        # and keeps them ahead of the system paths.
        GO_LINE="fish_add_path $GO_BIN_NEEDLE"
        # shellcheck disable=SC2016  # intentionally literal: expanded by fish later
        GOPATH_LINE='fish_add_path "$(go env GOPATH)/bin"'
    else
        GO_LINE="export PATH=$GO_BIN_NEEDLE:\$PATH"
        # shellcheck disable=SC2016  # intentionally literal: expanded by the user's shell later
        GOPATH_LINE='export PATH="$PATH:$(go env GOPATH)/bin"'
    fi

    SOURCE_CMD="source \"$PROFILE\""
}

detect_shell
info "Detected shell: $SHELL_NAME  (editing $PROFILE)"

if [[ "$DO_UNINSTALL" -eq 1 ]]; then
    do_uninstall
    exit 0
fi

# Mutating runs take a lock so two copies can't fight over /usr/local/go.
# (--check is read-only and skips it.)
if [[ "$DO_CHECK" -eq 0 ]]; then
    acquire_lock
fi

# --------------------------------------------------
# Required tools
# --------------------------------------------------

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        error "This script needs '$1', but it was not found on your system."
        case "$1" in
            jq)      error "Install it with:  brew install jq   (macOS)  or  sudo apt install jq   (Debian/Ubuntu)" ;;
            curl)    error "Install curl and try again." ;;
        esac
        exit 1
    fi
}

need curl
need jq

# --------------------------------------------------
# Permissions
# --------------------------------------------------

info "Refreshing sudo credentials (needed to write to $INSTALL_ROOT/go)..."
if ! sudo -v; then
    error "Could not get sudo permission to write to $INSTALL_ROOT/go."
    exit 1
fi

# --------------------------------------------------
# Latest release
# --------------------------------------------------

info "Fetching release information from go.dev..."

if ! JSON="$(fetch -s "https://go.dev/dl/?mode=json")"; then
    error "Could not reach go.dev to fetch release information."
    error "Check your internet connection and try again."
    exit 1
fi

# A proxy or captive portal can serve non-JSON junk; treat parse failures
# as "no data" so the checks below can report it kindly.
if [[ -n "$REQUESTED_VER" ]]; then
    TARGET_VER="$REQUESTED_VER"
else
    TARGET_VER="$(jq -r '.[0].version' <<< "$JSON" 2>/dev/null)" || true
fi

read -r FILENAME EXPECTED_HASH <<< "$(jq -r \
    --arg os "$GOOS" \
    --arg arch "$GOARCH" \
    --arg ver "$TARGET_VER" \
    '
    .[] | select(.version == $ver) | .files[]
    | select(.os == $os and .arch == $arch and .kind == "archive")
    | "\(.filename) \(.sha256)"
    ' <<< "$JSON")" || true

if [[ -z "$TARGET_VER" || "$TARGET_VER" == "null" ]]; then
    error "Failed to determine the Go version to install."
    exit 1
fi

if [[ -z "$FILENAME" || -z "$EXPECTED_HASH" ]]; then
    if [[ -n "$REQUESTED_VER" ]]; then
        error "Go $REQUESTED_VER wasn't found among the stable releases."
        error "See https://go.dev/dl/ for the available versions."
    else
        error "No official archive found for $GOOS/$GOARCH."
    fi
    exit 1
fi

DOWNLOAD_URL="https://go.dev/dl/${FILENAME}"

if [[ -n "$REQUESTED_VER" ]]; then
    success "Requested version: $TARGET_VER"
else
    success "Latest version: $TARGET_VER"
fi

# --------------------------------------------------
# Already up to date?
# --------------------------------------------------

# Compare against the install this script manages ($INSTALL_ROOT/go), not
# whatever "go" happens to be first on PATH (Homebrew, gvm, etc.).
CURRENT_VER=""

if [[ -x "$MANAGED_GO" ]]; then
    CURRENT_VER="$(go_version_of "$MANAGED_GO")"
elif command -v go >/dev/null 2>&1; then
    CURRENT_VER="$(go_version_of "go")"
    warn "Found Go ($CURRENT_VER) outside $INSTALL_ROOT/go — installing a fresh copy there."
fi

# --------------------------------------------------
# --check: report, change nothing
# --------------------------------------------------

if [[ "$DO_CHECK" -eq 1 ]]; then
    echo
    echo "  Go release       : $TARGET_VER"
    echo "  Installed        : ${CURRENT_VER:-none}"
    if [[ -z "$CURRENT_VER" ]]; then
        echo "  Status           : not installed"
    elif [[ "$CURRENT_VER" == "$TARGET_VER" ]]; then
        echo "  Status           : up to date"
    else
        echo "  Status           : update available"
    fi
    echo "  Would download   : $FILENAME"
    echo "  Install location : $INSTALL_ROOT/go"
    if profile_has "$GO_BIN_NEEDLE"; then
        echo "  Profile          : $PROFILE (PATH entries already present)"
    else
        echo "  Profile          : $PROFILE (PATH entries would be added)"
    fi
    echo
    info "Dry run — nothing was changed."
    exit 0
fi

if [[ -n "$CURRENT_VER" ]]; then
    if [[ "$CURRENT_VER" == "$TARGET_VER" && "$FORCE" -eq 0 ]]; then
        success "Go is already up to date ($CURRENT_VER). Nothing to do."
        echo
        echo "Pass --force to reinstall the same version anyway."
        exit 0
    fi

    warn "Current version: $CURRENT_VER"
fi

# --------------------------------------------------
# Download + verify
# --------------------------------------------------

CLEANUP_DIR="$(mktemp -d)"
cd "$CLEANUP_DIR"

info "Downloading ${FILENAME}..."
if ! fetch --progress-bar -O "$DOWNLOAD_URL"; then
    error "Download failed. Check your internet connection and try again."
    exit 1
fi
success "Download complete."

info "Verifying checksum..."

ACTUAL_HASH="$(compute_sha256 "$FILENAME")"

if [[ "$ACTUAL_HASH" != "$EXPECTED_HASH" ]]; then
    error "Checksum verification failed!"
    echo
    echo "Expected: $EXPECTED_HASH"
    echo "Actual:   $ACTUAL_HASH"
    exit 1
fi

success "Checksum verified."

# Sanity-check the archive layout before touching anything: the official
# tarballs always extract to a single top-level directory named "go".
info "Inspecting archive..."
ARCHIVE_LIST="$(tar -tzf "$FILENAME")"
TOP_DIR="${ARCHIVE_LIST%%$'\n'*}"
TOP_DIR="${TOP_DIR%%/*}"
if [[ "$TOP_DIR" != "go" ]]; then
    error "Unexpected archive layout (top-level '$TOP_DIR', expected 'go')."
    error "Nothing was changed — please try again later."
    exit 1
fi

# --------------------------------------------------
# Install
# --------------------------------------------------

info "Removing previous installation at $INSTALL_ROOT/go..."
sudo rm -rf "$INSTALL_ROOT/go"

info "Installing Go..."
sudo tar -C "$INSTALL_ROOT" -xzf "$FILENAME"
success "Installation complete."

INSTALLED_VER="$(go_version_of "$MANAGED_GO")"
if [[ "$INSTALLED_VER" != "$TARGET_VER" ]]; then
    error "Installation looks wrong: $INSTALL_ROOT/go reports '${INSTALLED_VER:-unknown}', expected $TARGET_VER."
    exit 1
fi

# --------------------------------------------------
# PATH setup
# --------------------------------------------------

mkdir -p "$(dirname "$PROFILE")"
touch "$PROFILE"

add_profile_line() {
    printf '%s\n' "$1" >> "$PROFILE"
}

ensure_path_entry() {
    local needle="$1" line="$2" label="$3"
    if profile_has "$needle"; then
        info "$label is already on PATH in $PROFILE."
    else
        add_profile_line "$line"
        success "Added $label to PATH."
    fi
}

# The exact lines are defined per-shell in detect_shell(), so --uninstall
# can find and remove precisely what we add here.
ensure_path_entry "$GO_BIN_NEEDLE" "$GO_LINE" "Go"
ensure_path_entry "$GOPATH_NEEDLE" "$GOPATH_LINE" "GOPATH/bin"

# Make the new binaries available in this session too.
export PATH="$GO_BIN_NEEDLE:$PATH"
GOPATH_BIN="$("$MANAGED_GO" env GOPATH)/bin"
export PATH="$PATH:$GOPATH_BIN"

# --------------------------------------------------
# Summary
# --------------------------------------------------

ELAPSED=$(( $(date +%s) - START_TIME ))

echo
echo "=============================================="
success "Go installed successfully!"
echo "=============================================="
"$MANAGED_GO" version
echo
echo "Architecture : $GOARCH"
echo "OS           : $GOOS"
echo "Version      : $TARGET_VER"
echo "Installed To : $INSTALL_ROOT/go"
echo "Profile      : $PROFILE"
echo "Time         : ${ELAPSED}s"
echo

echo "If this is a new shell, load the changes with:"
echo
echo "    $SOURCE_CMD"
echo

success "Done!"
