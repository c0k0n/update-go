#!/usr/bin/env bash
#
# update-go — a tiny, careful updater for the Go toolchain.
#
# Works on Linux and macOS, and configures bash, zsh, or fish.
# It downloads the official archive straight from go.dev, verifies the
# published SHA-256 checksum, and replaces /usr/local/go in place.
#
# This is a personal tool shared in the hope it helps others. It is not
# affiliated with or endorsed by the Go project.

set -euo pipefail

START_TIME="$(date +%s)"

# --------------------------------------------------
# Presentation
# --------------------------------------------------

GREEN="\033[1;32m"
BLUE="\033[1;34m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
RESET="\033[0m"

info()    { echo -e "${BLUE}==>${RESET} $*"; }
success() { echo -e "${GREEN}✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}⚠${RESET} $*"; }
error()   { echo -e "${RED}✖${RESET} $*" >&2; }

usage() {
    cat <<'EOF'
update-go — update the Go toolchain from go.dev

Usage:
  update-go [options]

Options:
  -f, --force     Reinstall even if already on the latest version
  -h, --help      Show this help

The script installs to /usr/local/go and adds it (plus $GOPATH/bin) to the
PATH of the shell it detects from $SHELL (bash, zsh, or fish).
EOF
}

# --------------------------------------------------
# Argument parsing
# --------------------------------------------------

FORCE=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f|--force) FORCE=1 ;;
        -h|--help)  usage; exit 0 ;;
        *) error "Unknown option: $1"; usage; exit 1 ;;
    esac
    shift
done

# --------------------------------------------------
# Required tools
# --------------------------------------------------

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        error "This script needs '$1', but it was not found on your system."
        case "$1" in
            jq)      error "Install it with:  brew install jq   (macOS)  or  sudo apt install jq   (Debian/Ubuntu)" ;;
            curl)    error "Install curl and try again." ;;
        esac
        exit 1
    fi
}

need curl
need jq

# --------------------------------------------------
# Detect platform
# --------------------------------------------------

OS="$(uname -s)"
case "$OS" in
    Linux)  GOOS="linux"  ;;
    Darwin) GOOS="darwin" ;;
    *)
        error "Unsupported operating system: $OS"
        error "update-go currently supports Linux and macOS only."
        exit 1
        ;;
esac

info "Detecting system architecture..."

case "$(uname -m)" in
    x86_64|amd64) GOARCH="amd64" ;;
    aarch64|arm64) GOARCH="arm64" ;;
    i386|i486|i586|i686) GOARCH="386" ;;
    armv6l|armv7l) GOARCH="armv6l" ;;  # Go publishes one 32-bit ARM build; runs on v6 and v7
    *)
        error "Unsupported architecture: $(uname -m)"
        exit 1
        ;;
esac

# --------------------------------------------------
# Detect shell + the profile we should edit
# --------------------------------------------------

detect_shell() {
    local shell_name
    shell_name="$(basename "${SHELL:-/bin/bash}")"

    case "$shell_name" in
        zsh)
            PROFILE="$HOME/.zshrc"
            SHELL_FAMILY="posix"
            SOURCE_CMD="source \"$PROFILE\""
            ;;
        bash)
            # macOS bash is usually a login shell (uses .bash_profile).
            if [[ "$GOOS" == "darwin" ]]; then
                PROFILE="$HOME/.bash_profile"
            else
                PROFILE="$HOME/.bashrc"
            fi
            SHELL_FAMILY="posix"
            SOURCE_CMD="source \"$PROFILE\""
            ;;
        fish)
            # fish reads $XDG_CONFIG_HOME/fish/config.fish, which defaults
            # to ~/.config/fish/config.fish.
            PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
            SHELL_FAMILY="fish"
            SOURCE_CMD="source \"$PROFILE\""
            ;;
        *)
            PROFILE="$HOME/.profile"
            SHELL_FAMILY="posix"
            SOURCE_CMD="source \"$PROFILE\""
            ;;
    esac
}

detect_shell
info "Detected shell: $(basename "${SHELL:-/bin/bash}")  (editing $PROFILE)"

# --------------------------------------------------
# Permissions
# --------------------------------------------------

info "Refreshing sudo credentials (needed to write to /usr/local/go)..."
if ! sudo -v; then
    error "Could not get sudo permission to write to /usr/local/go."
    exit 1
fi

# --------------------------------------------------
# Latest release
# --------------------------------------------------

info "Fetching latest Go release information..."

if ! JSON="$(curl -fsSL --retry 3 --retry-delay 2 "https://go.dev/dl/?mode=json")"; then
    error "Could not reach go.dev to fetch release information."
    error "Check your internet connection and try again."
    exit 1
fi

LATEST_VER="$(jq -r '.[0].version' <<< "$JSON")"

read -r FILENAME EXPECTED_HASH <<< "$(jq -r \
    --arg os "$GOOS" \
    --arg arch "$GOARCH" \
    '
    .[0].files[]
    | select(.os == $os and .arch == $arch and .kind == "archive")
    | "\(.filename) \(.sha256)"
    ' <<< "$JSON")" || true

if [[ -z "$LATEST_VER" || "$LATEST_VER" == "null" ]]; then
    error "Failed to determine latest Go version."
    exit 1
fi

if [[ -z "$FILENAME" || -z "$EXPECTED_HASH" ]]; then
    error "No official archive found for $GOOS/$GOARCH."
    exit 1
fi

DOWNLOAD_URL="https://go.dev/dl/${FILENAME}"

success "Latest version: $LATEST_VER"

# --------------------------------------------------
# Already up to date?
# --------------------------------------------------

# Compare against the install this script manages (/usr/local/go), not
# whatever "go" happens to be first on PATH (Homebrew, gvm, etc.).
MANAGED_GO="/usr/local/go/bin/go"
CURRENT_VER=""

if [[ -x "$MANAGED_GO" ]]; then
    CURRENT_VER="$("$MANAGED_GO" version 2>/dev/null | awk '{print $3}')" || true
elif command -v go >/dev/null 2>&1; then
    CURRENT_VER="$(go version 2>/dev/null | awk '{print $3}')" || true
    warn "Found Go ($CURRENT_VER) outside /usr/local/go — installing a fresh copy there."
fi

if [[ -n "$CURRENT_VER" ]]; then
    if [[ "$CURRENT_VER" == "$LATEST_VER" && "$FORCE" -eq 0 ]]; then
        success "Go is already up to date ($CURRENT_VER). Nothing to do."
        echo
        echo "Pass --force to reinstall the same version anyway."
        exit 0
    fi

    warn "Current version: $CURRENT_VER"
fi

# --------------------------------------------------
# Download + verify
# --------------------------------------------------

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

cd "$WORKDIR"

info "Downloading ${FILENAME}..."
if ! curl -fL --progress-bar --retry 3 --retry-delay 2 -O "$DOWNLOAD_URL"; then
    error "Download failed. Check your internet connection and try again."
    exit 1
fi
success "Download complete."

info "Verifying checksum..."

compute_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        error "Need 'sha256sum' or 'shasum' to verify the checksum, but neither was found."
        return 1
    fi
}

ACTUAL_HASH="$(compute_sha256 "$FILENAME")"

if [[ "$ACTUAL_HASH" != "$EXPECTED_HASH" ]]; then
    error "Checksum verification failed!"
    echo
    echo "Expected: $EXPECTED_HASH"
    echo "Actual:   $ACTUAL_HASH"
    exit 1
fi

success "Checksum verified."

# --------------------------------------------------
# Install
# --------------------------------------------------

info "Removing previous installation at /usr/local/go..."
sudo rm -rf /usr/local/go

info "Installing Go..."
sudo tar -C /usr/local -xzf "$FILENAME"
success "Installation complete."

INSTALLED_VER="$(/usr/local/go/bin/go version 2>/dev/null | awk '{print $3}')" || true
if [[ "$INSTALLED_VER" != "$LATEST_VER" ]]; then
    error "Installation looks wrong: /usr/local/go reports '${INSTALLED_VER:-unknown}', expected $LATEST_VER."
    exit 1
fi

# --------------------------------------------------
# PATH setup
# --------------------------------------------------

GO_BIN_LINE="/usr/local/go/bin"
# shellcheck disable=SC2016  # intentionally literal: expanded by the user's shell later
GOPATH_BIN_LINE='$(go env GOPATH)/bin'

mkdir -p "$(dirname "$PROFILE")"
touch "$PROFILE"

profile_has() {
    # True if the profile has a non-comment line mentioning $1.
    grep -v '^[[:space:]]*#' "$PROFILE" 2>/dev/null | grep -qF "$1"
}

add_profile_line() {
    printf '%s\n' "$1" >> "$PROFILE"
}

ensure_path_entry() {
    local needle="$1" line="$2" label="$3"
    if profile_has "$needle"; then
        info "$label is already on PATH in $PROFILE."
    else
        add_profile_line "$line"
        success "Added $label to PATH."
    fi
}

if [[ "$SHELL_FAMILY" == "fish" ]]; then
    # fish_add_path is fish's official helper: it deduplicates entries and
    # keeps them ahead of the system paths.
    ensure_path_entry "$GO_BIN_LINE" "fish_add_path $GO_BIN_LINE" "Go"
    # shellcheck disable=SC2016  # intentionally literal: expanded by the user's shell later
    ensure_path_entry "$GOPATH_BIN_LINE" 'fish_add_path "$(go env GOPATH)/bin"' "GOPATH/bin"
else
    ensure_path_entry "$GO_BIN_LINE" "export PATH=$GO_BIN_LINE:\$PATH" "Go"
    # shellcheck disable=SC2016  # intentionally literal: expanded by the user's shell later
    ensure_path_entry "$GOPATH_BIN_LINE" 'export PATH="$PATH:$(go env GOPATH)/bin"' "GOPATH/bin"
fi

# Make the new binaries available in this session too.
export PATH="/usr/local/go/bin:$PATH"
GOPATH_BIN="$(/usr/local/go/bin/go env GOPATH)/bin"
export PATH="$PATH:$GOPATH_BIN"

# --------------------------------------------------
# Summary
# --------------------------------------------------

ELAPSED=$(( $(date +%s) - START_TIME ))

echo
echo "=============================================="
success "Go installed successfully!"
echo "=============================================="
/usr/local/go/bin/go version
echo
echo "Architecture : $GOARCH"
echo "OS           : $GOOS"
echo "Version      : $LATEST_VER"
echo "Installed To : /usr/local/go"
echo "Profile      : $PROFILE"
echo "Time         : ${ELAPSED}s"
echo

echo "If this is a new shell, load the changes with:"
echo
echo "    $SOURCE_CMD"
echo

success "Done!"
